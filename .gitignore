import os
import urllib.request
import urllib.parse
from pathlib import Path

import folder_paths


ALLOWED_EXTENSIONS = (
    ".safetensors",
    ".ckpt",
    ".pt",
    ".pth",
    ".bin",
    ".gguf",
)


def normalize_huggingface_url(url: str) -> str:
    """
    Converts Hugging Face file page URLs from /blob/main/ to /resolve/main/.
    Example:
    https://huggingface.co/user/repo/blob/main/model.safetensors
    ->
    https://huggingface.co/user/repo/resolve/main/model.safetensors
    """
    if "huggingface.co" in url and "/blob/" in url:
        url = url.replace("/blob/", "/resolve/")
    return url


def extract_filename_from_url(url: str) -> str:
    parsed = urllib.parse.urlparse(url)
    filename = os.path.basename(parsed.path)
    return filename.strip()


class DownloadModelByURL:
    @classmethod
    def INPUT_TYPES(cls):
        return {
            "required": {
                "url": ("STRING", {
                    "default": "https://huggingface.co/Kijai/LTX2.3_comfy/blob/main/diffusion_models/ltx-2.3-22b-distilled-1.1_transformer_only_fp8_scaled.safetensors",
                    "multiline": False
                }),
                "model_type": ([
                    "checkpoints",
                    "loras",
                    "vae",
                    "clip",
                    "clip_vision",
                    "controlnet",
                    "upscale_models",
                    "diffusion_models",
                    "text_encoders",
                ],),
                "filename": ("STRING", {
                    "default": "",
                    "multiline": False
                }),
            }
        }

    RETURN_TYPES = ("STRING",)
    RETURN_NAMES = ("status",)
    FUNCTION = "download"
    CATEGORY = "utils/model_downloader"

    def download(self, url, model_type, filename):
        try:
            url = url.strip()
            filename = filename.strip()

            if not url:
                return ("Ошибка: ссылка пустая",)

            if not url.startswith("https://"):
                return ("Ошибка: разрешены только https-ссылки",)

            # Auto-fix Hugging Face blob -> resolve
            normalized_url = normalize_huggingface_url(url)

            # If filename is empty, try to take it from URL
            if not filename:
                filename = extract_filename_from_url(normalized_url)

            safe_name = os.path.basename(filename)

            if not safe_name:
                return ("Ошибка: не удалось определить имя файла",)

            if ".." in filename or "/" in filename or "\\" in filename:
                return ("Ошибка: имя файла не должно содержать путь",)

            ext = os.path.splitext(safe_name)[1].lower()
            if ext not in ALLOWED_EXTENSIONS:
                return ("Ошибка: разрешены только .safetensors, .ckpt, .pt, .pth, .bin, .gguf",)

            base_models_dir = Path(folder_paths.models_dir)
            target_dir = base_models_dir / model_type
            target_dir.mkdir(parents=True, exist_ok=True)

            target_path = target_dir / safe_name

            if target_path.exists():
                return (f"Файл уже существует: {target_path}",)

            # Optional headers to reduce some download issues
            request = urllib.request.Request(
                normalized_url,
                headers={
                    "User-Agent": "Mozilla/5.0"
                }
            )

            with urllib.request.urlopen(request) as response, open(target_path, "wb") as out_file:
                total = response.length
                downloaded = 0
                block_size = 1024 * 1024  # 1 MB

                while True:
                    buffer = response.read(block_size)
                    if not buffer:
                        break
                    out_file.write(buffer)
                    downloaded += len(buffer)

            return (
                f"Готово. Модель загружена: {target_path}\n"
                f"Исходная ссылка: {url}\n"
                f"Использована ссылка: {normalized_url}"
            )

        except Exception as e:
            return (f"Ошибка загрузки: {str(e)}",)


NODE_CLASS_MAPPINGS = {
    "DownloadModelByURL": DownloadModelByURL,
}

NODE_DISPLAY_NAME_MAPPINGS = {
    "DownloadModelByURL": "Download Model by URL",
}
